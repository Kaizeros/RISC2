`timescale 1ns / 1ps

module data_mem (
    input  logic        clk,
    input  logic        mem_write_en, // 1 = Write (Store Word), 0 = Read (Load Word)
    input  logic [31:0] address,
    input  logic [31:0] write_data,
    output logic [31:0] read_data
);

    logic [31:0] ram [0:63];
    logic [29:0] word_address;
    
    assign word_address = address[31:2];

    initial begin
        $readmemh("./data_init.txt", ram); 
    end

    always_ff @(posedge clk) begin    
        if (mem_write_en) begin       
            if (word_address < 64) begin
                ram[word_address] <= write_data;
            end
        end                           
    end                               

    // Clean, normal synthesizable readout
    assign read_data = (word_address < 64) ? ram[word_address] : 32'h00000000; 
endmodule 
