module data_mem (
    input  logic        clk,
    input  logic        mem_write_en, // 1 = Write (Store Word), 0 = Read (Load Word)
    input  logic [31:0] address,
    input  logic [31:0] write_data,
    output logic [31:0] read_data
);

    logic [31:0] ram [0:63];

    initial begin
        // Pre-initialize our RAM variables from a text file
        $readmemh("./data_init.txt", ram); //in the qsim or modelsim file
    end

    // Sequential Write: Writes happen on the rising edge of the clock
    always_ff @(posedge clk) begin    // <-- Opens always_ff
        if (mem_write_en) begin       // <-- Opens if statement
            ram[address[31:2]] <= write_data;
        end                           // <-- Closes if statement
    end                               // <-- Closes always_ff

    // Combinational Read: Continuous readout of the targeted address (Safe outside!)
    assign read_data = ram[address[31:2]];

endmodule 
