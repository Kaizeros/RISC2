`timescale 1ns / 1ps

module sign_ext (
    input  logic [31:0] inst,         // Pass the full 32-bit instruction word
    output logic [31:0] extended
);

    logic [6:0] opcode;
    assign opcode = inst[6:0];        // Extract opcode to check the instruction type

    always_comb begin
        case (opcode)
            // I-Type Instructions (ADDI, ORI, Load Word, etc.)
            7'b0010011, 7'b0000011: begin
                extended = {{20{inst[31]}}, inst[31:20]};
            end
            
            // S-Type Instructions (Store Word, Store Byte, etc.)
            7'b0100011: begin
                extended = {{20{inst[31]}}, inst[31:25], inst[11:7]};
            end
            
            // Default fallback to prevent latches
            default: begin
                extended = 32'h00000000;
            end
        endcase
    end

endmodule 
